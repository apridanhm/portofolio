---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import data from '../data/site.json';

const { site } = data;
---

<BaseLayout title={site.title} description={site.description}>
  <Hero />
  
  <section id="skills" class="py-20 px-4 bg-terminal-card/30">
    <div class="max-w-6xl mx-auto text-center">
      <h2 class="text-3xl font-bold mb-4"><span class="text-terminal-green">$</span> skills --list</h2>
      <p class="text-terminal-gray">Loading skills...</p>
    </div>
  </section>
</BaseLayout>
