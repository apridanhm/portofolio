---
import data from '../data/site.json';
const { projects } = data;
---

<section id="projects" class="py-20 px-4">
  <div class="max-w-6xl mx-auto">
    
    <!-- Header -->
    <div class="mb-8">
      <h2 class="text-3xl font-bold mb-2 flex items-center gap-2">
        <span class="text-terminal-green">$</span>
        <span class="font-mono">kubectl get deployments</span>
      </h2>
      <div class="h-px bg-gradient-to-r from-terminal-cyan/50 to-transparent"></div>
    </div>

    <!-- Projects Grid -->
    <div class="grid md:grid-cols-2 gap-6">
      {projects.map((project) => (
        <div class="bg-terminal-bg border border-terminal-border rounded-lg overflow-hidden hover:border-terminal-green/50 transition-all group">
          
          <!-- Card Header -->
          <div class="px-6 py-4 bg-terminal-card/50 border-b border-terminal-border flex items-center justify-between">
            <div class="flex items-center gap-3">
              <div class={`w-3 h-3 rounded-full ${project.status === 'Active' || project.status === 'Production' ? 'bg-green-500 animate-pulse' : 'bg-yellow-500'}`}></div>
              <h3 class="font-semibold text-lg">{project.title}</h3>
            </div>
            <span class={`px-3 py-1 rounded-full text-xs font-mono ${
              project.status === 'Production' ? 'bg-green-500/20 text-green-400' :
              project.status === 'Active' ? 'bg-blue-500/20 text-blue-400' :
              'bg-yellow-500/20 text-yellow-400'
            }`}>
              {project.status}
            </span>
          </div>

          <!-- Card Body -->
          <div class="p-6">
            <p class="text-terminal-gray mb-4 text-sm leading-relaxed">{project.desc}</p>
            
            <!-- Tech Stack -->
            <div class="flex flex-wrap gap-2 mb-4">
              {project.tech.map((tech) => (
                <span class="px-2 py-1 bg-terminal-card border border-terminal-border rounded text-xs font-mono text-terminal-cyan">
                  {tech}
                </span>
              ))}
            </div>

            <!-- Metrics -->
            <div class="grid grid-cols-2 gap-4 pt-4 border-t border-terminal-border">
              {project.uptime && (
                <div>
                  <div class="text-xs text-terminal-gray mb-1">UPTIME</div>
                  <div class="text-sm font-mono text-terminal-green">{project.uptime}</div>
                </div>
              )}
              {project.nodes && (
                <div>
                  <div class="text-xs text-terminal-gray mb-1">NODES</div>
                  <div class="text-sm font-mono text-terminal-cyan">{project.nodes}</div>
                </div>
              )}
              {project.users && (
                <div>
                  <div class="text-xs text-terminal-gray mb-1">USERS</div>
                  <div class="text-sm font-mono text-terminal-cyan">{project.users}</div>
                </div>
              )}
            </div>
          </div>

          <!-- Card Footer -->
          <div class="px-6 py-3 bg-terminal-card/30 border-t border-terminal-border">
            <a 
              href={project.link} 
              target="_blank" 
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 text-sm text-terminal-green hover:text-emerald-400 transition-colors font-mono"
            >
              <span>View Repository</span>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
              </svg>
            </a>
          </div>

        </div>
      ))}
    </div>

  </div>
</section>